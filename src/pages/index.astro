---
// DreamLand Spa & Wellness Landing Page
// Production-grade 1:1 Figma Design Replication to Astro
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DreamLand | Sanctuary for Rest & Balance</title>
    <meta
      name="description"
      content="Step into a space designed for total relaxation. From deep tissue massages to rejuvenating skincare treatments, we help you unwind, recharge, and feel your best inside and out."
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Great+Vibes&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind CSS CDN Engine -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              cream: '#FAF7F2',
              'cream-warm': '#F9F8F5',
              dark: '#181716',
              'dark-surface': '#181716',
              muted: '#78716A',
              'muted-taupe': '#78716A',
              border: '#E4DDD3',
              'accent-border': '#E4DDD3'
            },
            fontFamily: {
              serif: ['"Playfair Display"', '"Cormorant Garamond"', 'Georgia', 'serif'],
              display: ['"Cormorant Garamond"', '"Playfair Display"', 'Georgia', 'serif'],
              sans: ['"Plus Jakarta Sans"', 'system-ui', '-apple-system', 'sans-serif'],
              script: ['"Great Vibes"', 'cursive']
            }
          }
        }
      };
    </script>

    <style>
      :root {
        --bg-cream: #FAF7F2;
        --dark-surface: #181716;
        --muted-taupe: #78716A;
        --border-subtle: #E4DDD3;
      }

      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        background-color: #FAF7F2;
        color: #181716;
      }

      .font-script {
        font-family: 'Great Vibes', cursive;
      }

      .font-display {
        font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
      }

      .font-serif {
        font-family: 'Playfair Display', 'Cormorant Garamond', Georgia, serif;
      }

      /* 2-Second Alternating Color Animation */
      @keyframes alternateDream {
        0%, 100% {
          color: #181716;
          text-shadow: 0 0 1px rgba(255, 255, 255, 0.4);
        }
        50% {
          color: #FFFFFF;
          text-shadow: 0 1px 3px rgba(24, 23, 22, 0.45);
        }
      }

      @keyframes alternateLand {
        0%, 100% {
          color: #FFFFFF;
          text-shadow: 0 1px 3px rgba(24, 23, 22, 0.45);
        }
        50% {
          color: #181716;
          text-shadow: 0 0 1px rgba(255, 255, 255, 0.4);
        }
      }

      .word-dream {
        animation: alternateDream 2s ease-in-out infinite;
      }

      .word-land {
        animation: alternateLand 2s ease-in-out infinite;
      }

      .reveal-on-scroll {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
      }

      .reveal-on-scroll.is-revealed {
        opacity: 1;
        transform: translateY(0);
      }

      .delay-100 { transition-delay: 100ms; }
      .delay-200 { transition-delay: 200ms; }
      .delay-300 { transition-delay: 300ms; }

      .facet-polygon {
        clip-path: polygon(32% 0%, 100% 18%, 88% 100%, 0% 84%, 0% 26%);
      }
    </style>
  </head>

  <body class="bg-[#FAF7F2] text-[#181716] font-sans antialiased overflow-x-hidden selection:bg-[#181716] selection:text-white">

    <!-- MOBILE MENU BACKDROP (DIMMER BACKDROP) -->
    <div
      id="mobile-menu-backdrop"
      class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300 ease-out md:hidden"
      aria-hidden="true"
    ></div>

    <!-- MOBILE MENU OVERLAY (FLOATING DARK CARD MATCHING FIGMA 1:1) -->
    <div
      id="mobile-menu-overlay"
      class="fixed inset-4 z-50 bg-[#181716] rounded-3xl p-6 sm:p-8 flex flex-col justify-between shadow-2xl border border-white/10 opacity-0 -translate-y-8 scale-95 pointer-events-none transition-all duration-300 ease-out md:hidden"
      role="dialog"
      aria-modal="true"
      aria-label="Navigation Menu"
    >
      <!-- Header: Cursive script "DreamLand" logo + white "✕" close button -->
      <div class="flex items-center justify-between w-full">
        <a href="#hero" class="mobile-nav-link font-script text-3xl sm:text-4xl text-white tracking-wide select-none">
          DreamLand
        </a>
        <button
          id="mobile-menu-close"
          class="text-white p-2 rounded-full hover:bg-white/10 transition-colors focus:outline-none"
          aria-label="Close navigation menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Links: Centered vertical stack (Home, Contact, Services, About, FAQs) in clean white text -->
      <nav class="flex flex-col items-center justify-center space-y-6 my-auto text-center">
        <a href="#hero" class="mobile-nav-link text-white text-xl sm:text-2xl font-light hover:text-stone-300 transition-colors tracking-wide">Home</a>
        <a href="#contact" class="mobile-nav-link text-white text-xl sm:text-2xl font-light hover:text-stone-300 transition-colors tracking-wide">Contact</a>
        <a href="#services" class="mobile-nav-link text-white text-xl sm:text-2xl font-light hover:text-stone-300 transition-colors tracking-wide">Services</a>
        <a href="#about" class="mobile-nav-link text-white text-xl sm:text-2xl font-light hover:text-stone-300 transition-colors tracking-wide">About</a>
        <a href="#faqs" class="mobile-nav-link text-white text-xl sm:text-2xl font-light hover:text-stone-300 transition-colors tracking-wide">FAQs</a>
      </nav>

      <!-- Bottom Dual Action: White pill button [ Book a Spot ] + white circular button with diagonal arrow ( ↗ ) -->
      <div class="flex items-center justify-center gap-3 pt-4 w-full max-w-xs mx-auto">
        <a
          href="#book"
          class="mobile-nav-link flex-1 bg-white text-[#181716] font-medium py-3.5 px-6 rounded-full text-center text-sm sm:text-base shadow-lg hover:bg-stone-100 transition-colors"
        >
          Book a Spot
        </a>
        <a
          href="#book"
          class="mobile-nav-link w-12 h-12 rounded-full bg-white flex items-center justify-center text-[#181716] shadow-lg hover:bg-stone-100 transition-colors shrink-0"
          aria-label="Book a Spot arrow"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
          </svg>
        </a>
      </div>
    </div>




    <!-- SECTION 1: HERO SECTION (FIGMA 1:1 REPLICATION) -->
    <section id="hero" class="relative w-full min-h-screen lg:min-h-[920px] flex flex-col justify-between overflow-hidden bg-[#181716] text-white select-none">
      <!-- Full-bleed background image with warm ambient overlays -->
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=2000&q=85"
          alt="DreamLand Spa Massage Background"
          class="w-full h-full object-cover object-center scale-105"
        />
        <!-- Ambient Dark Gradient Overlays for Figma 1:1 contrast -->
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-black/30 pointer-events-none"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/40 pointer-events-none"></div>
      </div>

      <!-- Top Header Navigation Bar Overlaid on Hero -->
      <header class="w-full pt-6 sm:pt-8 pb-4 px-6 sm:px-10 lg:px-16 max-w-[1400px] mx-auto flex items-center justify-between relative z-20">
        <!-- Logo on Left -->
        <a href="#hero" class="font-script text-3xl sm:text-4xl text-white tracking-wide hover:opacity-90 transition-opacity select-none drop-shadow-md">
          DreamLand
        </a>

        <!-- Desktop Navigation & CTA Buttons on Right -->
        <div class="hidden md:flex items-center gap-3">
          <!-- Glass Navigation Pill -->
          <nav class="bg-black/35 backdrop-blur-md border border-white/15 rounded-full px-7 py-2.5 flex items-center space-x-7 text-sm font-medium text-white/90 shadow-lg">
            <a href="#hero" class="hover:text-white transition-colors">Home</a>
            <a href="#contact" class="hover:text-white transition-colors">Contact</a>
            <a href="#services" class="hover:text-white transition-colors">Services</a>
            <a href="#about" class="hover:text-white transition-colors">About</a>
            <a href="#faqs" class="hover:text-white transition-colors">FAQs</a>
          </nav>

          <!-- Action Pill Button "Book a Spot" -->
          <a
            href="#book"
            class="bg-white hover:bg-stone-100 text-[#181716] font-medium px-6 py-2.5 rounded-full text-sm shadow-md transition-all hover:scale-[1.03] active:scale-[0.98]"
          >
            Book a Spot
          </a>

          <!-- Action Circle Button with Diagonal Arrow ↗ -->
          <a
            href="#book"
            class="w-10 h-10 rounded-full bg-white hover:bg-stone-100 text-[#181716] flex items-center justify-center shadow-md transition-all hover:scale-[1.05] shrink-0"
            aria-label="Book a Spot arrow"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </a>
        </div>

        <!-- Mobile Hamburger Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden text-white p-2.5 rounded-full bg-black/40 backdrop-blur-md border border-white/15 hover:bg-white/20 transition-colors focus:outline-none"
          aria-label="Open navigation menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </header>

      <!-- Main Hero Content Body -->
      <div class="w-full max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16 py-12 sm:py-16 md:py-20 z-20 relative flex-1 flex flex-col justify-center">
        <div class="max-w-2xl">
          <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-[82px] xl:text-[88px] font-serif font-normal text-white leading-[1.06] tracking-tight mb-6 drop-shadow-md">
            Relax. Restore.<br />
            Renew.
          </h1>
          <p class="text-sm sm:text-base md:text-lg text-white/85 font-light leading-relaxed max-w-xl mb-8 drop-shadow-sm">
            Step into a space designed for total relaxation. From deep tissue massages to rejuvenating skincare treatments, we help you unwind, recharge, and feel your best inside and out.
          </p>
          <div>
            <a
              href="#book"
              class="inline-flex items-center justify-center bg-white hover:bg-stone-100 text-[#181716] font-medium px-8 py-3.5 rounded-full text-base shadow-xl transition-all hover:scale-[1.03] active:scale-[0.98]"
            >
              Book a Spot
            </a>
          </div>
        </div>
      </div>
      <!-- Hero Bottom Bar: Social Proof (Left) & Floating Glass Card (Right) -->
      <div class="w-full max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16 pb-8 sm:pb-12 z-20 relative flex flex-col md:flex-row items-start md:items-end justify-between gap-8 md:gap-6">
        <!-- Bottom Left: Avatar Group + 5,000+ Clients Stat -->
        <div class="flex items-center gap-4">
          <div class="flex items-center -space-x-3">
            <img
              class="w-11 h-11 sm:w-12 sm:h-12 rounded-full border-2 border-white/30 object-cover shadow-md"
              src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80"
              alt="Client avatar 1"
            />
            <img
              class="w-11 h-11 sm:w-12 sm:h-12 rounded-full border-2 border-white/30 object-cover shadow-md"
              src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=200&q=80"
              alt="Client avatar 2"
            />
          </div>
          <div class="flex flex-col">
            <span class="text-2xl sm:text-3xl font-serif font-normal text-white leading-none mb-1">5,000+</span>
            <span class="text-xs sm:text-sm text-white/75 font-light tracking-wide">clients restored & refreshed</span>
          </div>
        </div>

        <!-- Bottom Right: Floating Dark Glass Card -->
        <div class="w-full sm:w-[340px] md:w-[360px] lg:w-[380px] bg-[#2A2421]/60 backdrop-blur-xl border border-white/15 rounded-[28px] p-5 sm:p-6 shadow-2xl">
          <div class="flex items-start justify-between gap-3 mb-4">
            <p class="text-xs sm:text-sm text-white/85 font-light leading-snug max-w-[220px]">
              A premium wellness experience tailored to your body, your needs, your peace.
            </p>
            <a
              href="#services"
              class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white hover:bg-stone-100 text-[#181716] flex items-center justify-center shrink-0 shadow-md transition-all hover:scale-105"
              aria-label="Learn more about wellness experience"
            >
              <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>
          <div class="w-full h-36 sm:h-40 rounded-2xl overflow-hidden shadow-inner relative">
            <img
              src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=800&q=80"
              alt="Spa treatment thumbnail preview"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </section>


    <!-- SECTION 2: "More Than a Treatment, A Full Experience." -->
    <section class="py-20 md:py-32 bg-[#FAF7F2]">
      <div class="max-w-7xl mx-auto px-6">
        
        <div class="max-w-2xl mx-auto text-center mb-16 md:mb-20">
          <h2 class="reveal-on-scroll text-3xl sm:text-4xl md:text-5xl font-serif text-[#181716] leading-tight mb-5">
            More Than a Treatment,<br />A Full Experience.
          </h2>
          <p class="reveal-on-scroll delay-100 text-stone-600 text-base md:text-lg font-light leading-relaxed max-w-lg mx-auto">
            Every visit is designed to help you disconnect from stress and reconnect with yourself through calming, intentional care.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8 items-start">
          
          <!-- Card 1 -->
          <div class="reveal-on-scroll flex flex-col items-center text-center group">
            <div class="w-full max-w-[270px] h-[380px] rounded-full overflow-hidden mb-6 shadow-md bg-stone-200 relative">
              <img
                src="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?auto=format&fit=crop&w=800&q=80"
                alt="Soothing scents and sound"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              />
            </div>
            <h3 class="text-stone-800 text-base font-normal max-w-[190px] leading-snug">
              Soothing scents and sound
            </h3>
          </div>

          <!-- Card 2 -->
          <div class="reveal-on-scroll delay-100 flex flex-col items-center text-center group">
            <div class="w-full max-w-[270px] h-[380px] rounded-full overflow-hidden mb-6 shadow-md bg-stone-200 relative">
              <img
                src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=800&q=80"
                alt="Personalized service approach"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              />
            </div>
            <h3 class="text-stone-800 text-base font-normal max-w-[190px] leading-snug">
              Personalized service approach
            </h3>
          </div>

          <!-- Card 3 -->
          <div class="reveal-on-scroll delay-200 flex flex-col items-center text-center group">
            <div class="w-full max-w-[270px] h-[380px] rounded-full overflow-hidden mb-6 shadow-md bg-stone-200 relative">
              <img
                src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=800&q=80"
                alt="Peaceful, minimalist interiors"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              />
            </div>
            <h3 class="text-stone-800 text-base font-normal max-w-[190px] leading-snug">
              Peaceful, minimalist interiors
            </h3>
          </div>

        </div>

      </div>
    </section>

    <!-- SECTION DIVIDER -->
    <div class="max-w-7xl mx-auto px-6">
      <hr class="border-t border-stone-200/80" />
    </div>


    <!-- SECTION 3: SERVICES ("01 Massage Therapy") -->
    <section id="services" class="py-20 md:py-32 bg-[#FAF7F2]">
      <div class="max-w-7xl mx-auto px-6">
        
        <div class="reveal-on-scroll mb-10">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-stone-300 text-xs text-stone-700 font-medium bg-stone-50">
            <span class="w-1.5 h-1.5 rounded-full bg-stone-900"></span>
            Services
          </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <div class="lg:col-span-5">
            <div class="reveal-on-scroll text-6xl md:text-7xl font-serif text-[#181716] mb-5 tracking-tight font-light">
              01
            </div>
            
            <h2 class="reveal-on-scroll delay-100 text-3xl md:text-4xl font-serif text-[#181716] mb-4">
              Massage Therapy
            </h2>

            <p class="reveal-on-scroll delay-200 text-stone-600 font-light leading-relaxed mb-8 max-w-md text-sm md:text-base">
              Relaxing, deep tissue, and therapeutic massages to relieve tension and improve circulation.
            </p>

            <div class="reveal-on-scroll delay-200 flex items-center gap-3 mb-8">
              <button
                class="w-11 h-11 rounded-full bg-[#181716] text-white flex items-center justify-center hover:bg-stone-800 transition-colors shadow"
                aria-label="Previous Service"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              <button
                class="w-11 h-11 rounded-full bg-[#181716] text-white flex items-center justify-center hover:bg-stone-800 transition-colors shadow"
                aria-label="Next Service"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>

            <div class="reveal-on-scroll delay-300 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#181716]"></span>
              <span class="w-2.5 h-2.5 rounded-full border border-stone-400 bg-transparent"></span>
              <span class="w-2.5 h-2.5 rounded-full border border-stone-400 bg-transparent"></span>
              <span class="w-2.5 h-2.5 rounded-full border border-stone-400 bg-transparent"></span>
            </div>
          </div>

          <div class="lg:col-span-7">
            <div class="reveal-on-scroll delay-100 relative max-w-md mx-auto lg:ml-auto">
              <div class="absolute -inset-3 sm:-inset-4 border border-stone-400/80 rounded-[32px] translate-x-3 translate-y-3 pointer-events-none"></div>
              
              <div class="relative rounded-[28px] overflow-hidden shadow-xl bg-stone-100 h-[420px] sm:h-[480px]">
                <img
                  src="https://images.unsplash.com/photo-1600334129128-685c5582fd35?auto=format&fit=crop&w=800&q=80"
                  alt="Therapeutic Massage Therapy"
                  class="w-full h-full object-cover"
                />
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- SECTION DIVIDER -->
    <div class="max-w-7xl mx-auto px-6">
      <hr class="border-t border-stone-200/80" />
    </div>


    <!-- SECTION 4: "Simple Booking. Seamless Experience." -->
    <section id="book" class="py-20 md:py-32 bg-[#FAF7F2]">
      <div class="max-w-7xl mx-auto px-6">
        
        <div class="reveal-on-scroll mb-10">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-stone-300 text-xs text-stone-700 font-medium bg-stone-50">
            <span class="w-1.5 h-1.5 rounded-full bg-stone-900"></span>
            Book appointment
          </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          
          <div class="lg:col-span-5">
            <h2 class="reveal-on-scroll text-3xl sm:text-4xl md:text-5xl font-serif text-[#181716] leading-tight mb-5">
              Simple Booking.<br />
              Seamless<br />
              Experience.
            </h2>
            
            <p class="reveal-on-scroll delay-100 text-stone-600 font-light leading-relaxed mb-8 max-w-sm text-sm md:text-base">
              We make it easy to relax — from scheduling to your final moment of calm.
            </p>

            <div class="reveal-on-scroll delay-200 rounded-3xl overflow-hidden shadow-lg max-w-sm h-52 sm:h-60">
              <img
                src="https://images.unsplash.com/photo-1600334129128-685c5582fd35?auto=format&fit=crop&w=800&q=80"
                alt="Calming organic massage oils"
                class="w-full h-full object-cover"
              />
            </div>
          </div>

          <div class="lg:col-span-7 flex flex-col divide-y divide-stone-200/90">
            
            <!-- Step 01 -->
            <div class="reveal-on-scroll pb-6 pt-2">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-baseline gap-4">
                  <span class="text-stone-400 font-serif text-lg">01</span>
                  <h3 class="text-xl md:text-2xl font-serif text-stone-900 font-normal">
                    Choose Your Treatment
                  </h3>
                </div>
